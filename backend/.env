# ============================================================================
# CONFIGURAÇÕES DO AMBIENTE LOCAL
# ============================================================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=escola_tcc
DB_USER=postgres
DB_PASSWORD=123

# Segurança
JWT_SECRET=escola_tcc_jwt_secret_key_2024_super_segura
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS - Permitir frontend
FRONTEND_URL=http://localhost:8081

# Upload de arquivos
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info
LOG_FORMAT=combined